{
  "name": "artskart3.webapp",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "generate-api-types": "run-script-os",
    "generate-api-types:windows": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& openapi-typescript https://localhost:5088/swagger/v1/swagger.json --output ./src/app/shared/types/api.generated.ts",
    "generate-api-types:default": "NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript https://localhost:5088/swagger/v1/swagger.json --output ./src/app/shared/types/api.generated.ts",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1"
  },
  "prettier": {
    "printWidth": 140,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@artsdatabanken/components": "^1.4.2",
    "@artsdatabanken/tokens": "^1.1.6",
    "@artsdatabanken/nbic-map-component": "0.3.0",
    "@microsoft/applicationinsights-angularplugin-js": "^15.3.8",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "jest-editor-support": "*",
    "run-script-os": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.63.1",
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-win32-x64-msvc": "4.63.1"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
