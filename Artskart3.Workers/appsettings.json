{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Name": ""
  },
  "ConnectionStrings": {
    "ArtskartIndex": "",
    "ArtskartIndex_Worker": ""
  },
  "Hangfire": {
    "ScheduleDefaults": {
      "DatabaseMaintenance": "0 0 * * *",
      "Harvest": "0 1 * * *",
      "CsvExportPoll": "* * * * * *",
      "CsvExportCleanup": "0 3 * * *",
      "AlienSpeciesAssessment": "0 2 * * 1"
    }
  },
  "KartverketEiendom": {
    "BaseUrl": "https://api.kartverket.no/eiendom/v1/",
    "TimeoutSeconds": 10
  },
  "AlienSpeciesAssessment": {
    "Enabled": true,
    "BaseUrl": "https://lister.artsdatabanken.no/odata/v1/",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "MaxPageCount": 1000,
    "MinimumCurrentAssessmentCount": 1,
    "IndexProjectionBatchSize": 500000,
    "IndexZeroProjectionBatchSize": 500000,
    "IndexProjectionCommandTimeoutSeconds": 900,
    "CategoryTypeName": "Fremmedart",
    "CurrentAssessmentUrlPrefix": "https://lister.artsdatabanken.no/arter/fremmedartslista/",
    "Snapshot2023AssessmentUrlPrefix": "https://lister.artsdatabanken.no/fremmedartslista/2023/",
    "ForceSnapshot2023Refresh": false,
    "ResetAssessmentsBeforeSync": false
  },
  "CsvExport": {
    "BlobStorage": {
      "ConnectionString": "",
      "ContainerName": "csv-exports"
    },
    "Worker": {
      "BatchSize": 5000,
      "InterBatchDelayMs": 100,
      "StuckJobTimeoutMinutes": 10,
      "MaxAttempts": 3,
      "ExpiresAtDays": 180
    }
  }
}
