# Kopier til .env og fyll inn. .env er ignorert av git og skal aldri sjekkes inn.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database - SQL Server som kjører som tjeneste på vertsmaskinen
# ---------------------------------------------------------------------------
# Hele tilkoblingsstrengen settes her, så den takler hvilket som helst
# instansnavn og autentiseringsoppsett.
#
# Tre ting må være på plass for at en container skal nå vertsmaskinens
# SQL Server:
#
#   1. TCP/IP må være aktivert på instansen, og den må lytte på en kjent port
#      (1433 for en navngitt standardinstans). LocalDB kan IKKE nås fra en
#      container - den lytter bare på en lokal named pipe.
#   2. SQL-autentisering. Integrated Security / Trusted_Connection virker ikke fra
#      en container, siden den ikke har din Windows-identitet. Du trenger et
#      SQL-login med passord.
#   3. Windows-brannmuren må slippe inn innkommende 1433 fra podman-nettverket.
#
# Verten: IKKE host.docker.internal. Under podman på Windows kjører containerne i
# en WSL-maskin, og host.docker.internal peker på den maskinen - ikke på Windows.
# Bruk adressen Windows har på WSL-adapteren:
#
#   podman machine ssh "ip route | grep default"
#
# Den adressen kan endre seg når Windows startes på nytt, og må da oppdateres her.
DB_CONNECTION_STRING=Server=172.30.0.1,1433;Database=Artskart3Index;User Id=;Password=;TrustServerCertificate=True;MultipleActiveResultSets=True

# ---------------------------------------------------------------------------
# Blob storage - Azurite i container
# ---------------------------------------------------------------------------
# Azurite sin innebygde utviklingskonto. Nøkkelen er offentlig dokumentert og
# identisk for alle som kjører Azurite - den er ikke en hemmelighet. Verten må
# være azurite og ikke 127.0.0.1, siden tjenestene snakker med hverandre over
# container-nettverket (UseDevelopmentStorage=true peker på localhost og virker
# derfor ikke her).
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# ---------------------------------------------------------------------------
# Innlogging
# ---------------------------------------------------------------------------
# La stå tomme hvis du bare skal verifisere at tjenestene starter; da fungerer
# helsesjekk, frontend og Workers, men ikke pålogging. Skal pålogging testes,
# bruk https://localhost:49219 - den returadressen er allerede registrert hos
# identitetsleverandøren, fordi det er opphavet Angular dev-serveren bruker.
AUTH_AUTHORITY=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
